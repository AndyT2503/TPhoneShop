{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "commerce": {
        "ClusterId": "commerce",
        "Match": {
          "Path": "/commerce/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/commerce"
          }
        ]
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/notification/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notification"
          }
        ]
      },
      "file": {
        "ClusterId": "file",
        "Match": {
          "Path": "/file/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/file"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:501/"
          }
        }
      },
      "commerce": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:500/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:502/"
          }
        }
      },
      "file": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:503/"
          }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:4202"
    ]
  },
  "Jwt": {
    "Issuer": "http://localhost:501",
    "Audience": "tphone_shop_services"
  }
}
