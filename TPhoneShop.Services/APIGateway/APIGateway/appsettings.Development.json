{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "commerce": {
        "ClusterId": "commerce",
        "Match": {
          "Path": "/commerce/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/commerce"
          }
        ]
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/notification/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notification"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:501/"
          }
        }
      },
      "commerce": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:500/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:502/"
          }
        }
      }
    }
  }
}
